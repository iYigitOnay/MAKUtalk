generator client {
  provider = "prisma-client-js"
  previewFeatures = ["filteredRelationCount"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        BigInt   @id
  email     String   @unique
  username  String   @unique
  password  String
  fullName  String?
  bio       String?  @db.Text
  avatarUrl String?
  coverUrl  String?  
  department String? 
  class      String? 
  isVerified Boolean  @default(false)
  isPrivate  Boolean  @default(false)
  isBanned   Boolean  @default(false)
  role       UserRole @default(USER)
  verificationCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts                Post[]
  likes                Like[]
  comments             Comment[]
  bookmarks            Bookmark[]
  following            Follow[]       @relation("UserFollowing")
  followers            Follow[]       @relation("UserFollowers")
  notifications        Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationSender")
  blockedUsers         Block[]        @relation("Blocker")
  blockedBy            Block[]        @relation("Blocked")
  badges               UserBadge[]
  sentRequests         FollowRequest[] @relation("SentRequests")
  receivedRequests     FollowRequest[] @relation("ReceivedRequests")
  foundedClubs         Club[]          @relation("ClubFounder")
  advisorClubs         Club[]          @relation("ClubAdvisor")
  clubMemberships      ClubMember[]
  
  feedbacks            Feedback[]
  reportsSent          Report[]        @relation("ReportedBy")
  reportsAgainst       Report[]        @relation("ReportedUser")
  
  conversations        ConversationParticipant[]
  messagesSent         Message[] @relation("SentMessages")
  spotListings         SpotListing[]
  createdEvents        Event[] @relation("EventCreator")
  attendedEvents       EventParticipant[]
}

model Event {
  id          BigInt   @id
  title       String
  description String   @db.Text
  date        DateTime
  location    String?
  campus      String?  @default("İstiklal")
  type        String   @default("DİĞER")
  imageUrl    String?
  creatorId   BigInt
  clubId      BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator      User               @relation("EventCreator", fields: [creatorId], references: [id])
  club         Club?              @relation(fields: [clubId], references: [id])
  participants EventParticipant[]

  @@index([date])
}

model EventParticipant {
  id        BigInt   @id
  eventId   BigInt
  userId    BigInt
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Conversation {
  id          BigInt   @id
  isAccepted  Boolean  @default(true)
  isRejected  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             BigInt   @id
  conversationId BigInt
  userId         BigInt
  themeColor     String   @default("#4f46e5")
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             BigInt   @id
  conversationId BigInt
  senderId       BigInt
  content        String?  @db.Text
  postId         BigInt?  // Paylaşılan postun ID'si
  mediaUrl       String?  // Yüklenen medyanın yolu
  mediaType      String?  // IMAGE, VIDEO, FILE
  thumbnailUrl   String?  // Videolar için kapak fotoğrafı
  isRead         Boolean  @default(false)
  isForwarded    Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  sharedPost   Post?        @relation("SharedPost", fields: [postId], references: [id], onDelete: SetNull)
  reports      Report[]

  @@index([conversationId])
  @@index([senderId])
  @@index([postId])
}

enum BadgeType {
  USER
  CLUB
}

model Badge {
  id          BigInt      @id
  name        String      @unique
  icon        String?     
  color       String      @default("#1E3A8A")
  description String?
  type        BadgeType   @default(USER)
  createdAt   DateTime    @default(now())

  users       UserBadge[]
  clubs       ClubBadge[]
}

model UserBadge {
  id        BigInt   @id
  userId    BigInt
  badgeId   BigInt
  assignedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model ClubBadge {
  id        BigInt   @id
  clubId    BigInt
  badgeId   BigInt
  assignedAt DateTime @default(now())

  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([clubId, badgeId])
}

model FollowRequest {
  id          BigInt        @id
  senderId    BigInt
  receiverId  BigInt
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  sender      User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
  ACADEMIC
}

model Category {
  id          BigInt   @id
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#6B7280")
  icon        String?
  createdAt   DateTime @default(now())

  posts Post[]
}

model Post {
  id         BigInt   @id
  content    String?  @db.Text
  imageUrl   String?  
  videoUrl   String?  // Video dosyasının yolu
  thumbnailUrl String? // Video için kapak fotoğrafı
  documentUrl String?
  isAcademic Boolean  @default(false)
  published  Boolean  @default(true)
  authorId   BigInt
  categoryId BigInt?
  repostId   BigInt?  
  parentId   BigInt?  // <- TWITTER MANTIĞI: Bu post hangi posta cevap olarak atıldı?
  sentiment      String?  
  sentimentScore Float?
  isDeleted  Boolean  @default(false)
  isProcessing Boolean  @default(false)
  deletedAt  DateTime? 
  isPinned    Boolean   @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  repostOf      Post?          @relation("Reposts", fields: [repostId], references: [id], onDelete: Cascade)
  reposts       Post[]         @relation("Reposts")
  
  parent        Post?          @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Post[]         @relation("PostReplies")

  likes         Like[]
  comments      Comment[]
  notifications Notification[]
  reports       Report[]
  bookmarks     Bookmark[]
  sharedInMessages Message[] @relation("SharedPost")
  hashtags      Hashtag[] @relation("PostHashtags")

  @@index([authorId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([repostId])
  @@index([parentId])
  @@index([isAcademic])
}

model Hashtag {
  id          BigInt   @id
  name        String   @unique // # olmadan isim, örn: "maku"
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]   @relation("PostHashtags")

  @@index([usageCount])
}

model Like {
  id        BigInt   @id
  userId    BigInt
  postId    BigInt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        BigInt   @id
  content   String   @db.Text
  userId    BigInt
  postId    BigInt
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reports Report[]
  notifications Notification[]

  @@index([postId])
  @@index([userId])
}

model Follow {
  id          BigInt   @id
  followerId  BigInt
  followingId BigInt
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id         BigInt           @id
  type       NotificationType
  recipientId BigInt
  senderId   BigInt?
  postId     BigInt?
  commentId  BigInt?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([read])
  @@index([createdAt])
}

model Block {
  id          BigInt   @id
  blockerId   BigInt   
  blockedId   BigInt   
  createdAt   DateTime @default(now())

  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Feedback {
  id        BigInt   @id
  type      String   
  message   String   @db.Text
  userId    BigInt?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Report {
  id                BigInt   @id
  reporterId        BigInt
  reporter          User     @relation("ReportedBy", fields: [reporterId], references: [id])
  reportedUserId    BigInt?
  reportedUser      User?    @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedPostId    BigInt?
  reportedPost      Post?    @relation(fields: [reportedPostId], references: [id])
  reportedCommentId BigInt?
  reportedComment   Comment? @relation(fields: [reportedCommentId], references: [id])
  reportedMessageId BigInt?
  reportedMessage   Message? @relation(fields: [reportedMessageId], references: [id])
  reason            String
  subReason         String?
  status            String   @default("PENDING") 
  createdAt         DateTime @default(now())
}

model Club {
  id               BigInt   @id
  name             String   @unique
  slug             String   @unique
  description      String   @db.Text
  mainType         ClubMainType @default(DIGITAL)
  category         String   
  emoji            String?  
  color            String   @default("#e11d48")
  logoUrl          String?  
  memberCount      Int      @default(0)
  maxMembers       Int?     
  deadline         DateTime?
  requiredSkills   String?  // Virgülle ayrılmış yetenekler
  metadata         Json?    // Dinamik alanlar için (mevki, proje kodu vb.)
  status           ClubStatus @default(PENDING)
  founderId        BigInt?
  advisorName      String?
  advisorEmail     String?
  academicApproval Boolean  @default(false)
  adminApproval    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  founder          User?    @relation("ClubFounder", fields: [founderId], references: [id])
  advisor          User?    @relation("ClubAdvisor", fields: [advisorEmail], references: [email])
  members          ClubMember[]
  badges           ClubBadge[]
  events           Event[]
}

model ClubMember {
  id        BigInt   @id
  clubId    BigInt
  userId    BigInt
  role      String   @default("MEMBER") 
  joinedAt  DateTime @default(now())

  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

enum ClubMainType {
  DIGITAL
  PROJECT
  SOCIAL
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LIKE    
  COMMENT 
  FOLLOW  
  MENTION
  REPOST
}

model SpotListing {
  id          BigInt       @id
  title       String       
  description String       @db.Text
  price       Float?       
  imageUrl    String?      
  category    SpotCategory @default(AL_SAT)
  status      ListingStatus @default(ACTIVE) 
  location    String?      
  contactInfo String?      
  isNegotiable Boolean     @default(false) 
  authorId    BigInt
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum SpotCategory {
  AL_SAT        
  EV_ARKADASI   
  KAMPUS_RADARI 
  YOL_ARKADASI  
  ODUNC         
  YETENEK       
  STAJ_IS       
}

enum ListingStatus {
  ACTIVE        
  SOLD          
  CLOSED        
}

model Bookmark {
  id        BigInt   @id
  userId    BigInt
  postId    BigInt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}
